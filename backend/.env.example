# Supply these through the deployment environment; no automatic .env loader.
DATABASE_URL=postgresql://user:password@host/database
ALLOWED_ORIGINS=https://data-science-topaz.vercel.app,http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep private. Never put this in a VITE_ variable or GitHub source.
ADMIN_KEY=replace-with-at-least-32-random-characters
